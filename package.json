{
  "name": "myself-dashboard",
  "version": "2.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bash scripts/export-expo-web.sh && next build",
    "export:web": "bash scripts/export-expo-web.sh",
    "start": "next start",
    "lint": "npm run typecheck",
    "db:apply": "tsx scripts/db-migrate.ts",
    "sync:leumi": "tsx scripts/finance/sync-leumi.ts",
    "sync:max": "tsx scripts/finance/sync-max.ts",
    "sync:cal": "tsx scripts/finance/sync-visa-cal.ts",
    "test": "node --import tsx --test lib/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p mobile/tsconfig.json",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.101",
    "@supabase/supabase-js": "^2.45.4",
    "ai": "^6.0.235",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "expo-server-sdk": "^6.1.0",
    "lucide-react": "^0.454.0",
    "next": "^16.2.10",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sergienko4/israeli-bank-scrapers": "^8.4.0",
    "@types/node": "^20.16.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}

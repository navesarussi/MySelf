# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Site auth (Google Sign-In)
AUTH_SECRET=
ALLOWED_GOOGLE_EMAIL=

# Google OAuth — one login connects Calendar + Tasks + Gmail (readonly)
# Authorized redirect URI in Google Cloud Console:
#   http://localhost:3000/api/auth/google/callback
#   https://myselfapp.xyz/api/auth/google/callback
# Enable APIs in Google Cloud (same project as CLIENT_ID): Calendar API, Google Tasks API, Gmail API.
# OAuth consent scopes: calendar.readonly, tasks, gmail.readonly
# Gmail API enable: https://console.cloud.google.com/apis/library/gmail.googleapis.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Legacy per-service redirects (optional; unified login uses GOOGLE_REDIRECT_URI above)
GOOGLE_TASKS_REDIRECT_URI=http://localhost:3000/api/integrations/google-tasks/callback

# GitHub Issues OAuth App (Developer settings → OAuth Apps)
# Production: https://myselfapp.xyz/api/integrations/github/callback
# Callback URL must match; scopes: repo, read:user
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/integrations/github/callback

# Monday.com OAuth (multi-account task source)
# Production: https://myselfapp.xyz/api/integrations/monday/callback
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
MONDAY_REDIRECT_URI=http://localhost:3000/api/integrations/monday/callback

CRON_SECRET=

# Gemini motivation agent (Google AI Studio / Gemini API)
GOOGLE_GENERATIVE_AI_API_KEY=

# Cursor Cloud Agents — chat-code bridge (קוד: / /dev prefixes)
# https://cursor.com/dashboard/api
CURSOR_API_KEY=

# WhatsApp Cloud API (step 2 — Meta Business)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DIG_TEMPLATE=myself_daily_reminder
WHATSAPP_DIG_TEMPLATE_LANG=he

# Trading system tick (GitHub Actions → /api/trading/tick every 15 min).
# Same value must be set as GitHub secret TRADING_CRON_SECRET (+ MYSELF_API_URL). Falls back to CRON_SECRET.
TRADING_CRON_SECRET=

# Alpaca PAPER trading (demo account — the adapter only talks to paper-api.alpaca.markets)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

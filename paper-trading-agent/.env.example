# Paper trading only. Never set this to a live Alpaca URL.
PAPER=true
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional decision providers. If neither is set, the agent returns a safe hold stub.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Risk controls
ALLOWED_SYMBOLS=AAPL,MSFT,NVDA,SPY,BTC/USD,ETH/USD
MAX_POSITION_PCT=0.05
MAX_DAILY_LOSS_PCT=0.03
HUMAN_APPROVAL_THRESHOLD_USD=1000
# Required for orders above HUMAN_APPROVAL_THRESHOLD_USD, even in paper mode.
APPROVE=0
